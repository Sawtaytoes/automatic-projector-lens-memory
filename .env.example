# ---- MQTT (required) --------------------------------------------------------
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Base topic; the service uses <prefix>/event, <prefix>/status, etc.
MQTT_TOPIC_PREFIX=lens-memory
# Home Assistant MQTT discovery prefix (leave default unless you changed it).
MQTT_DISCOVERY_PREFIX=homeassistant

# ---- Plex (optional; enables exact aspect-ratio lookup by rating key) --------
# Full base URL including scheme and port.
PLEX_URL=https://plex.example.com:32400
PLEX_TOKEN=YOUR_PLEX_TOKEN
# Set to false only if your Plex uses a self-signed certificate.
PLEX_VERIFY_TLS=true

# ---- Aspect-ratio calculations JSON (optional) ------------------------------
# Produced by an external scanner (e.g. Mux-Magic). Mounted read-only.
ASPECT_RATIOS_JSON_PATH=/data/aspectRatioCalculations.json
# One of: exactMaxHeightAspectRatio, exactMedianAspectRadio,
#         relativeMaxHeightAspectRatio, relativeMedianAspectRadio
ASPECT_RATIO_CALCULATION=relativeMedianAspectRadio

# ---- blu-ray.com fallback ---------------------------------------------------
BLURAY_COM_FALLBACK=true

# ---- Aspect ratio -> lens memory mode ---------------------------------------
# JSON object mapping aspect ratio to the remote command your projector knows.
# Default matches a JVC lens-memory preset remote (mode_1..mode_4).
LENS_MODE_MAPPING={"2.39":"mode_2","2.10":"mode_4","1.85":"mode_3","1.78":"mode_1","1.37":"mode_1","1.33":"mode_1"}
# Nearest-match tolerance so a scanned 2.40 still maps to the 2.39 bucket.
LENS_MODE_TOLERANCE=0.05
# Mode sent when playback stops (reset lens).
LENS_MODE_IDLE=mode_1

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
